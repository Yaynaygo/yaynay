# --- Build-time (public) ---
# bytes32 builder code from polymarket.com → Settings → Builder (goes into signed orders).
VITE_BUILDER_CODE=
# Cloudflare Turnstile site key (dashboard → Turnstile). Leave empty for local dev.
VITE_TURNSTILE_SITE_KEY=
# Set to 1 once Polymarket authorizes our builder key for session keys (1-click trading).
VITE_ONE_CLICK_TRADING=

# --- Server-only secrets (never prefix with VITE_) ---
# Local dev reads these from .env; on Cloudflare Pages set them as encrypted variables.
POLYMARKET_BUILDER_API_KEY=
POLYMARKET_BUILDER_SECRET=
POLYMARKET_BUILDER_PASSPHRASE=
# Cloudflare Pages only:
# SESSION_SECRET=<random 32+ chars>   signs the HttpOnly session cookie
# TURNSTILE_SECRET_KEY=<from Turnstile>
# ALLOWED_ORIGINS=https://yaynay.pages.dev   extra allowed origins, comma-separated
# D1 binding "DB" (database yaynay-limits) for the daily signer limits
